{
  "name": "zipzapbot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de WhatsApp para grupos: comandos, downloads e conversões sem IA, e IA apenas sob menção real ou resposta direta ao bot.",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "clean": "tsc --build --clean && rm -rf packages/*/dist apps/*/dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
