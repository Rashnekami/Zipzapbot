{
  "name": "zipzapbot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de WhatsApp para grupos: comandos, downloads e conversões sem IA, e IA apenas sob menção real ou resposta direta ao bot.",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build --force",
    "clean": "tsc --build --clean && rm -rf packages/*/dist apps/*/dist",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "db:migrate": "node packages/db/dist/cli.js up",
    "db:status": "node packages/db/dist/cli.js status",
    "test:unit": "vitest run --exclude \"tests/integration/**\"",
    "test:integration": "vitest run tests/integration"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^3.0.5",
    "baileys": "6.7.24",
    "bullmq": "^6.2.0",
    "eslint": "^9.18.0",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
